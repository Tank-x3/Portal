/* 全体の設定 */
body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
    background-color: #f4f4f9;
    color: #333;
    line-height: 1.6;
}

/* ヘッダー */
header {
    background-color: #4a4a4a;
    color: white;
    padding: 1.5rem 1rem;
}

.header-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    max-width: 960px;
    margin: 0 auto;
}

.logo {
    width: 128px;  /* ←ご指定のサイズに変更 */
    height: 128px; /* ←ご指定のサイズに変更 */
}

.header-text {
    text-align: left;
}

header h1 {
    margin: 0;
    font-size: 2.5rem;
}

header p {
    margin: 0.5rem 0 0;
    font-size: 1.1rem;
}


/* ▼▼▼ここからカードコンテナ（変更箇所）▼▼▼ */
/* カードコンテナ */
.card-container {
    display: grid; /* flexからgridに変更 */
    justify-content: center; /* グリッド全体を中央に配置 */
    padding: 2rem;
    gap: 2rem;
    /* grid-template-columnsはJavaScriptで動的に設定します */
}
/* ▲▲▲ここまでカードコンテナ（変更箇所）▲▲▲ */


/* ツールカード */
.tool-card {
    background-color: white;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    /* width: 340px; ← Gridで幅を管理するため不要になるのでコメントアウト or 削除 */
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s;
}

.tool-card:hover {
    transform: translateY(-5px);
}

/* (以下、変更なしのため省略) */
.tool-card img {
    width: 100%;
    height: 190px;
    object-fit: cover;
}

.card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.card-content h2 {
    margin-top: 0;
    font-size: 1.4rem;
}

.card-content p {
    font-size: 0.95rem;
    color: #555;
    flex-grow: 1;
}

details {
    margin-top: 1rem;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    padding: 0.5rem 1rem;
}

summary {
    cursor: pointer;
    font-weight: bold;
    padding: 0.5rem 0;
}

.details-content {
    padding-top: 0.5rem;
    font-size: 0.9rem;
    color: #444;
    border-top: 1px solid #e0e0e0;
    margin-top: 0.5rem;
}

.details-content a {
    display: block;
    margin-top: 0.8rem;
    font-weight: bold;
}

.tool-link-button {
    display: block;
    background-color: #007bff;
    color: white;
    text-align: center;
    padding: 0.8rem;
    text-decoration: none;
    border-radius: 5px;
    margin-top: 1.5rem;
    transition: background-color 0.2s;
}

.tool-link-button:hover {
    background-color: #0056b3;
}

footer {
    text-align: center;
    padding: 2rem;
    color: #777;
    font-size: 0.9rem;
}

@media (max-width: 768px) {
    .header-content {
        flex-direction: column;
        gap: 1rem;
    }
    .header-text {
        text-align: center;
    }
    header h1 {
        font-size: 2rem;
    }
    .card-container {
        padding: 1rem;
        gap: 1rem;
    }
    /* .tool-card { width: 100%; } ← Gridでは不要 */
}